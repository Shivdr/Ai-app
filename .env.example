# AI Girlfriend Voice Chat - Environment Configuration

# OpenAI API Key (required for AI chat and voice features)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=3000
HOST=localhost

# AI Personality Settings
AI_NAME=Luna
AI_PERSONALITY=warm,playful,caring,witty

# Voice Settings (OpenAI TTS voices: alloy, echo, fable, onyx, nova, shimmer)
TTS_VOICE=nova
TTS_MODEL=tts-1
TTS_SPEED=1.0

# Chat Model
CHAT_MODEL=gpt-4o
MAX_CONVERSATION_HISTORY=50

# Speech-to-Text Model
STT_MODEL=whisper-1
