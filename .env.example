# AI Girlfriend Voice Chat - Environment Configuration

# === API Keys (set at least one) ===

# Option 1: OpenRouter (recommended - supports many models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option 2: OpenAI directly (needed for voice features TTS/STT)
# If using OpenRouter for chat, you still need an OpenAI key for voice.
# If you only have OpenRouter, voice features will be disabled gracefully.
OPENAI_API_KEY=

# Server Configuration
PORT=3000
HOST=localhost

# AI Personality Settings
AI_NAME=Luna
AI_PERSONALITY=warm,playful,caring,witty

# Voice Settings (OpenAI TTS voices: alloy, echo, fable, onyx, nova, shimmer)
TTS_VOICE=nova
TTS_MODEL=tts-1
TTS_SPEED=1.0

# Chat Model (OpenRouter models: openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-pro, etc.)
CHAT_MODEL=openai/gpt-4o
MAX_CONVERSATION_HISTORY=50

# Speech-to-Text Model
STT_MODEL=whisper-1
